{
    "name": "jeffersonsimaogoncalves/cakephp-utils",
    "description": "Standalone REST API / DataTables helper classes for CakePHP 3 (plugin-less sibling of cakephp-utility).",
    "keywords": [
        "cakephp",
        "utils"
    ],
    "type": "cakephp-plugin",
    "homepage": "https://github.com/jeffersonsimaogoncalves/cakephp-utils",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "homepage": "https://github.com/jeffersonsimaogoncalves",
            "role": "Author"
        }
    ],
    "support": {
        "issues": "https://github.com/jeffersonsimaogoncalves/cakephp-utils/issues",
        "source": "https://github.com/jeffersonsimaogoncalves/cakephp-utils"
    },
    "require": {
        "php": ">=7.0",
        "airmanbzh/php-html-generator": "^1.0",
        "league/fractal": ">=0.13.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonSimaoGoncalves\\Utils\\": "src"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "htaccess-protect": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    }
}
